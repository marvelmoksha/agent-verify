# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=
FREELLMAPI_KEY=
# FreeLLMAPI proxy runs on your own machine (default port 3001)
FREELLMAPI_BASE_URL=http://localhost:3001/v1
# Local model server. Ollama default shown; for vLLM use http://localhost:8000/v1
LOCAL_BASE_URL=http://localhost:11434/v1
# Where JSONL logs go. On Colab, point this at Google Drive so runs survive disconnects:
# AGENT_VERIFY_LOG_DIR=/content/drive/MyDrive/agent-verify-logs
AGENT_VERIFY_LOG_DIR=logs
